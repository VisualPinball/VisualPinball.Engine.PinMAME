diff --git a/src/altsound.cpp b/src/altsound.cpp
index 4683db5..5a4063d 100644
--- a/src/altsound.cpp
+++ b/src/altsound.cpp
@@ -450,6 +450,12 @@ ALTSOUNDAPI bool AltSoundInit(const string& pinmamePath, const string& gameName,
 
 	// perform processor initialization (load samples, etc)
 	g_pProcessor->init();
+	if (!g_pProcessor->isInitialized()) {
+		ALT_ERROR(0, "FAILED: AltSound processor could not load the samples");
+		ALT_OUTDENT;
+		ALT_DEBUG(0, "END AltSoundInit()");
+		return false;
+	}
 
 	g_cmdData.cmd_counter = 0;
 	g_cmdData.stored_command = -1;
diff --git a/src/altsound_processor.cpp b/src/altsound_processor.cpp
index 6db3a9c..d4abcee 100644
--- a/src/altsound_processor.cpp
+++ b/src/altsound_processor.cpp
@@ -273,7 +273,8 @@ void AltsoundProcessorBase::setGlobalVol(const float vol_in)
 	for (size_t index = 0; index < channel_stream.size(); ++index) {
 		const auto stream = channel_stream[index];
 		if (stream) {
-			vol[index] = getStreamVolume(stream->hstream);
+			// a stream silenced by a zero volume has no level left to scale back up from: start over from its own gain
+			vol[index] = global_vol * master_vol > 0.0f ? getStreamVolume(stream->hstream) : stream->gain;
 		}
 	}
 
